sources/resources/code-examples/python/metrics_solution.py

# Copyrighted / source material — do not publish
papers/

# Regenerable datasets (raw corpora + derived gold; see data/SOURCES.md).
# Students rebuild these with prep_datasets.py / the download notebooks.
sources/resources/code-examples/data/raw/
sources/resources/code-examples/data/gold/
# ...and never let a render leak them into the published site
sources/docs/resources/code-examples/data/raw/

# Runtime artifact written by the Day-2 notebook warm-up cell (not a source file).
sources/notebooks/example_gold.json
sources/docs/resources/code-examples/data/gold/

# Quarto local build cache for `execute: freeze: auto` (executed cell outputs).
# Not part of deployment — .github/workflows/deploy.yml uploads sources/docs/ only,
# CI never renders. Kept local; a fresh clone re-renders computational pages from source.
sources/_freeze/

# Python bytecode
__pycache__/
*.pyc

# Local API keys for running the tutorials outside Colab — never commit
.env

.claude/settings.local.json
