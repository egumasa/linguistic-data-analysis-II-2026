.DS_Store

# Internal course-design notes (not published)
planning/

# Instructor private end-to-end run-through of the final mini-project
project-runthrough/

# Copyrighted / source material — do not publish
papers/

# Raw corpora (see sources/resources/datasets/SOURCES.md). Rebuilt with
# sources/resources/datasets/prep_datasets.py or the download notebooks.
# Already covered by sources/resources/datasets/.gitignore; repeated here so a render
# cannot leak them into the published site.
sources/docs/resources/datasets/raw/

# The derived gold JSON files under sources/resources/datasets/gold/ are TRACKED on
# purpose — the notebooks fetch them by raw.githubusercontent.com URL, so ignoring them
# would break the downloads.

# Runtime artifact written by the Day-2 notebook warm-up cell (not a source file).
sources/notebooks/example_gold.json

# Quarto local build cache for `execute: freeze: auto` (executed cell outputs).
# Not part of deployment — .github/workflows/deploy.yml uploads sources/docs/ only,
# CI never renders. Kept local; a fresh clone re-renders computational pages from source.
sources/_freeze/

# Python bytecode
__pycache__/
*.pyc

# Local API keys for running the tutorials outside Colab — never commit
.env

.claude/settings.local.json
